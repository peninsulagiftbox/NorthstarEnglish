# 复制后填写；或运行 scripts/init-local.sh 生成本项目专属随机密码。
WEB_PORT=3100
API_PORT=8085
MYSQL_PORT=3308
MYSQL_ROOT_PASSWORD=replace_with_64_hex_characters
DB_MIGRATION_PASSWORD=replace_with_64_hex_characters
DB_PASSWORD=replace_with_64_hex_characters
# 仅本项目命令使用；不修改全局 Java/Node。
# JAVA_HOME=/absolute/path/to/jdk-21/Contents/Home
# NORTHSTAR_NODE_BIN=/opt/homebrew/opt/node@22/bin
# 灾难恢复实例由 scripts/recovery_mysql.py 选择独立回环端口（默认尝试3310），
# 保存在 .local/phase09-recovery.json；不在此改写主站 MYSQL_PORT。
